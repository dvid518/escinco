{
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/",
    "tests/fixtures/",
    "*.md"
  ],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }]
  }
}
