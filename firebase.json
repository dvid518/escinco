{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "target": "landing",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/firebase/firestore.rules",
        "**/firebase/firestore.indexes.json",
        "firebase-debug.log",
        "package.json",
        "package-lock.json",
        "skills-lock.json",
        "*.md",
        "docs/**"
      ],
      "rewrites": [
        { "source": "/privacidad", "destination": "/privacidad.html" },
        { "source": "/terminos", "destination": "/terminos.html" },
        { "source": "/eliminar-datos", "destination": "/eliminar-datos.html" },
        { "source": "/demo", "destination": "/demo.html" },
        { "source": "/demo/**", "destination": "/demo.html" },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|mjs|css)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://www.googletagmanager.com https://identitytoolkit.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; font-src 'self' https://fonts.gstatic.com;" }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        },
        {
          "source": "/js/lib/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/icons/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        }
      ]
    },
    {
      "target": "app",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/firebase/firestore.rules",
        "**/firebase/firestore.indexes.json",
        "firebase-debug.log",
        "package.json",
        "package-lock.json",
        "skills-lock.json",
        "*.md",
        "docs/**",
        "index.html"
      ],
      "rewrites": [
        { "source": "/login", "destination": "/auth.html" },
        { "source": "/register", "destination": "/auth.html" },
        { "source": "/reset-password", "destination": "/reset-password.html" },
        { "source": "/", "destination": "/dashboard.html" },
        { "source": "/dashboard", "destination": "/dashboard.html" },
        { "source": "/cuentas", "destination": "/dashboard.html" },
        { "source": "/movimientos", "destination": "/dashboard.html" },
        { "source": "/inversiones", "destination": "/dashboard.html" },
        { "source": "/trading", "destination": "/dashboard.html" },
        { "source": "/configuracion", "destination": "/dashboard.html" }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|mjs|css)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://www.googletagmanager.com https://identitytoolkit.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; font-src 'self' https://fonts.gstatic.com;" }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        },
        {
          "source": "/js/lib/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/icons/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        }
      ]
    }
  ]
}
